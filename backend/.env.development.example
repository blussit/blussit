# =====================================================================
# Blussit backend — LOCAL DEVELOPMENT template
# Copy this file to backend/.env.development (same folder). Safe to share: no real keys.
# Loaded automatically when you run the backend on your machine.
# Live credentials live ONLY in backend/.env.production (deploy script).
# =====================================================================

# App
APP_NAME="Doorstep Vehicle Care Platform"
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

RATE_LIMIT_ENABLED=false
TRUST_PROXY_HEADERS=false
# 1 = Cloud Run direct; 2 if a Google HTTPS load balancer sits in front.
TRUSTED_PROXY_COUNT=1

# MongoDB
# Local docker Mongo (scripts/dev.sh starts it). NEVER the Atlas production cluster.
MONGO_URI="mongodb://127.0.0.1:27099/?replicaSet=rs0&directConnection=true"
MONGO_DB_NAME=blussit_dev

# JWT
# Any long random text. Used only on your machine.
JWT_SECRET_KEY=replace-with-any-long-random-text-for-local-dev-only-123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173

# Storage (Cloudflare R2)
# Uploads are saved on disk (UPLOAD_DIR), not in Cloudflare R2.
STORAGE_PROVIDER=local


# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# WhatsApp messaging (OTPs, temp passwords, booking/subscription updates).
# Fill in WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID from a WhatsApp
# Cloud API app to send for real; leave blank to keep using the safe
# log-only fallback (messages land in the whatsapp_outbox collection).
# log = messages are written to the whatsapp_outbox collection, never sent.
WHATSAPP_PROVIDER=log
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_BUSINESS_NUMBER=918962288774
# Set this once you have an approved "authentication"-category template
# (one {{1}} body placeholder for the code) — OTPs switch from plain text
# to it automatically. Until then, OTPs only reach a recipient with an
# already-open 24h WhatsApp session (confirmed working for 9302964803
# since it has one); a genuinely new customer's first OTP will not arrive.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
# Utility templates (see config.py): UPDATE body must be "{{1}}: {{2}}",
# TEMP_PASSWORD body must have one {{1}} placeholder. Blank = free-text
# fallback (only delivered inside an open 24h session).
WHATSAPP_UPDATE_TEMPLATE_NAME=blussit_service_update
WHATSAPP_TEMP_PASSWORD_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Incoming webhook (booking over WhatsApp chat). Paste the SAME verify
# token into Meta App Dashboard > WhatsApp > Configuration when setting the
# webhook callback URL (https://<your-api-domain>/api/v1/whatsapp/webhook).
# APP_SECRET is the Meta app's App Secret (App Dashboard > App settings >
# Basic) — set it in production so only Meta can post to the webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=

# SMS channel (OTP/temp-password bridge while WhatsApp auth templates await
# business verification, and permanent fallback after). "" = disabled
# (WhatsApp-only), "log" = dev/test, "fast2sms" (quick-start, no DLT
# needed, OTP-only) or "msg91" (needs DLT + template) = real sending.
# OTP_CHANNEL picks which channel is tried first; the other is fallback.
SMS_PROVIDER=
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
MSG91_OTP_TEMPLATE_ID=
OTP_CHANNEL=whatsapp

# Google Maps + OAuth
# Google Maps keys: ask the project owner for the DEV keys (or create your own in Google Cloud).
# Without them the map picker doesn't load; everything else works.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
# Optional: Google sign-in. Leave blank — phone OTP login works without it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Razorpay Standard Checkout — LIVE keys (real money moves on every
# payment). For development/testing, comment these two and uncomment the
# test pair below.
# ACTIVE pair — what the app actually uses. TEST while we're testing.
# Razorpay TEST MODE keys go here (Dashboard -> switch to Test Mode -> API Keys; they start rzp_test_).
# Blank = online payments off locally; cash bookings still work. Never put rzp_live_ keys in this file.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The real keys, parked here so they're never lost and never accidentally
# active. To go live: copy these two values up into the pair above.
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=

# Photos you upload locally are saved in backend/uploads (relative to the backend folder).
UPLOAD_DIR=uploads
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_UPLOAD_PREFIX=photos
R2_PRIVATE_BUCKET_NAME=
PUBLIC_BASE_URL=http://localhost:8000
RAZORPAY_WEBHOOK_SECRET=

# --- Local testing shortcuts (ignored unless APP_ENV=development AND the
# --- database above is on this machine) ---------------------------------
# Every OTP is DEV_OTP_CODE and nothing is actually sent.
DEV_TOOLS_ENABLED=true
DEV_OTP_CODE=123456
