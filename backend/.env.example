# App
APP_NAME=
APP_ENV=
API_V1_PREFIX=
DEBUG=
RATE_LIMIT_ENABLED=
TRUST_PROXY_HEADERS=

# MongoDB
MONGO_URI=
MONGO_DB_NAME=

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# CORS
CORS_ORIGINS=

# Storage (local for dev, Cloudflare R2 for production)
STORAGE_PROVIDER=
UPLOAD_DIR=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PRIVATE_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_UPLOAD_PREFIX=

# Pagination defaults
DEFAULT_PAGE_SIZE=
MAX_PAGE_SIZE=

# WhatsApp messaging (OTPs, temp passwords, booking/subscription updates).
# Leave WHATSAPP_PROVIDER=log (or the two keys below blank) to run without
# a real WhatsApp account — messages are written to the whatsapp_outbox
# collection instead of sent, so everything still works end-to-end in dev.
# To send for real: set WHATSAPP_PROVIDER=meta_cloud and fill in a token +
# phone number ID from a WhatsApp Cloud API app (Meta for Developers).
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=
# Once you have an approved "authentication"-category template (one {{1}}
# body placeholder for the code), set its name here — OTPs switch from
# plain text to that template automatically. Required for a brand-new
# customer's first-ever OTP to actually arrive (plain text only reaches
# someone with an already-open 24h WhatsApp session).
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=
# Utility templates (see config.py): UPDATE body must be "{{1}}: {{2}}",
# TEMP_PASSWORD body must have one {{1}} placeholder. Blank = free-text
# fallback (only delivered inside an open 24h session).
WHATSAPP_UPDATE_TEMPLATE_NAME=
WHATSAPP_TEMP_PASSWORD_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
# Incoming webhook (booking over WhatsApp chat) — see whatsapp_webhook_routes.py.
# Put the same verify token in Meta App Dashboard > WhatsApp > Configuration;
# APP_SECRET enables signature verification of incoming posts (production).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=


# SMS channel (OTP/temp-password bridge while WhatsApp auth templates await
# business verification, and permanent fallback after). "" = disabled
# (WhatsApp-only), "log" = dev/test, "fast2sms" (quick-start, no DLT
# needed, OTP-only) or "msg91" (needs DLT + template) = real sending.
# OTP_CHANNEL picks which channel is tried first; the other is fallback.
SMS_PROVIDER=
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
MSG91_OTP_TEMPLATE_ID=
OTP_CHANNEL=

# Google Maps + OAuth (blank placeholders — real values live in .env only)
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Razorpay Standard Checkout — key id is public (sent to the browser for
# the checkout modal); the SECRET signs/verifies payments and must never
# leave the backend.
# Razorpay. The ACTIVE pair is what customers are charged against — a test
# key id starts rzp_test_, a live one rzp_live_. The backend logs which mode
# it booted in and labels the checkout "TEST MODE" when it isn't live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Park the live pair here while testing so switching back is a copy, not a
# hunt. Nothing reads these.
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
# Public https base of the backend (prod), e.g. https://api.blussit.com —
# payment-link callbacks land on {PUBLIC_BASE_URL}/api/v1/payments/link-callback.
# Blank in dev: the reminder-loop link sweep settles paid links instead.
PUBLIC_BASE_URL=
