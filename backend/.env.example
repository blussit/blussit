# Template only. Real values live in two git-ignored files:
#   backend/.env.development  local testing (test DB, test keys) — read by default
#   backend/.env.production   LIVE credentials — read only by scripts/deploy-gcp.sh
# Pick another file for a local run with ENV_FILE=<name>.
# App
APP_NAME=
APP_ENV=
API_V1_PREFIX=
DEBUG=
RATE_LIMIT_ENABLED=
TRUST_PROXY_HEADERS=
# Safe production values: TRUST_PROXY_HEADERS=true, TRUSTED_PROXY_COUNT=1 (Cloud Run direct).
# 0 is never read as 1 (the app refuses to start with trust on and a count
# below 1); 2+ is refused unless ALLOW_PROXY_COUNT_GT_1=true (external load balancer).
TRUSTED_PROXY_COUNT=
ALLOW_PROXY_COUNT_GT_1=

# MongoDB
MONGO_URI=
MONGO_DB_NAME=

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# CORS
CORS_ORIGINS=

# Storage (local for dev, Cloudflare R2 for production)
STORAGE_PROVIDER=
UPLOAD_DIR=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PRIVATE_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_UPLOAD_PREFIX=

# Pagination defaults
DEFAULT_PAGE_SIZE=
MAX_PAGE_SIZE=

# WhatsApp messaging (OTPs, temp passwords, booking/subscription updates).
# Leave WHATSAPP_PROVIDER=log (or the two keys below blank) to run without
# a real WhatsApp account — messages are written to the whatsapp_outbox
# collection instead of sent, so everything still works end-to-end in dev.
# To send for real: set WHATSAPP_PROVIDER=meta_cloud and fill in a token +
# phone number ID from a WhatsApp Cloud API app (Meta for Developers).
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=
# Our own WhatsApp sender number — no account may use it as its phone (Meta cannot message itself).
WHATSAPP_BUSINESS_NUMBER=
# Once you have an approved "authentication"-category template (one {{1}}
# body placeholder for the code), set its name here — OTPs switch from
# plain text to that template automatically. Required for a brand-new
# customer's first-ever OTP to actually arrive (plain text only reaches
# someone with an already-open 24h WhatsApp session).
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=
# Utility templates (see config.py): UPDATE body should be "*{{1}}*\n{{2}}\nCall us for any query.",
# TEMP_PASSWORD body must have one {{1}} placeholder. Blank = free-text
# fallback (only delivered inside an open 24h session).
WHATSAPP_UPDATE_TEMPLATE_NAME=blussit_service_update_v3
WHATSAPP_TEMP_PASSWORD_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
# Incoming webhook (booking over WhatsApp chat) — see whatsapp_webhook_routes.py.
# Put the same verify token in Meta App Dashboard > WhatsApp > Configuration;
# APP_SECRET enables signature verification of incoming posts (production).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=


# SMS channel (OTP/temp-password bridge while WhatsApp auth templates await
# business verification, and permanent fallback after). "" = disabled
# (WhatsApp-only), "log" = dev/test, "msg91" (needs the auth key; the
# OTP template id is optional) = real sending.
# OTP_CHANNEL picks which channel is tried first; the other is fallback.
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
MSG91_OTP_TEMPLATE_ID=
OTP_CHANNEL=

# Google Maps + OAuth (blank placeholders — real values live in .env only)
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Razorpay Standard Checkout — key id is public (sent to the browser for
# the checkout modal); the SECRET signs/verifies payments and must never
# leave the backend.
# Razorpay. The ACTIVE pair is what customers are charged against — a test
# key id starts rzp_test_, a live one rzp_live_. The backend logs which mode
# it booted in and labels the checkout "TEST MODE" when it isn't live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Park the live pair here while testing so switching back is a copy, not a
# hunt. Nothing reads these.
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
# Public https base of the backend (prod), e.g. https://api.blussit.com —
# payment-link callbacks land on {PUBLIC_BASE_URL}/api/v1/payments/link-callback.
# Blank in dev: the reminder-loop link sweep settles paid links instead.
PUBLIC_BASE_URL=

# Captain GPS integrity (location check on Arrived / Start / Complete).
# ON by default: a step is REFUSED when the captain's position is outside the
# customer's radius, stale, too inaccurate, replayed, or the stored trail
# looks faked; a manager of that center (or an admin) can approve one step of
# one job. GEOFENCE_ENFORCE=false is the emergency kill switch: the same
# checks still run and are recorded, but nothing is refused. Radius, accuracy
# cap, fix age etc. are editable in Admin > Pricing > Checks & Reminders.
GEOFENCE_ENFORCE=true
# Shortest believable wash, in seconds, between the before-photo and
# completion (0 turns the floor off; also editable in Business Settings).
GEOFENCE_MIN_SERVICE_SECONDS=120

# Local testing only (ignored unless APP_ENV=development AND a local database)
DEV_TOOLS_ENABLED=
DEV_OTP_CODE=

# ---- Auth hardening (all optional — blank = the default shown) ----------------
# Login throttle: per (account + device + source IP), never account-wide.
LOGIN_THROTTLE_STEPS=            # 5:60,10:300,20:1800  fails:lock-seconds, escalating
LOGIN_FAIL_WINDOW_MINUTES=       # 60   a bucket forgets its failures after this long
LOGIN_IP_FAIL_CEILING=           # 60   failures from one IP across all accounts ...
LOGIN_IP_WINDOW_SECONDS=         # 600  ... within this window block that IP ...
LOGIN_IP_BLOCK_SECONDS=          # 600  ... for this long (trusted devices never blocked)
LOGIN_ACCOUNT_SLOWDOWN_FAILS=    # 30   account-wide failures/hour that slow UNKNOWN devices
LOGIN_ACCOUNT_SLOWDOWN_SECONDS=  # 2.0  the delay (slows, never blocks)
TRUSTED_DEVICES_MAX=             # 10   hashed device ids remembered per user
# OTP requests.
OTP_RESEND_COOLDOWN_SECONDS=     # 60   one request per phone per N seconds (same live code re-sent)
OTP_SOURCE_HOURLY_LIMIT=         # 5    requests/hour per device (or per IP without X-Device-Id); the next starts a hold
OTP_IP_HOURLY_LIMIT=             # 30   requests/hour per IP (shared carrier IPs: roomy); the next starts a hold
OTP_HOLD_STEPS_SECONDS=          # 300,1800,7200,86400  escalating hold per repeated violation
OTP_HOLD_MEMORY_SECONDS=         # 86400  how long a violation is remembered
OTP_PHONE_SOURCE_HOURLY_LIMIT=   # 5    codes/hour for one phone from one requester
OTP_PHONE_HOURLY_LIMIT=          # 15   codes/hour for one phone in all; beyond it only first-time requesters
OTP_PHONE_ABSOLUTE_HOURLY_LIMIT= # 40   hard ceiling per phone per hour (owner's own trusted device exempt)
OTP_GLOBAL_HOURLY_BUDGET=        # 500  platform-wide WhatsApp+SMS code messages/hour
OTP_GLOBAL_DAILY_BUDGET=         # 3000 ... per day. Crossing logs an ERROR, alerts admins+managers once, slows new sources
OTP_OVER_BUDGET_COOLDOWN_SECONDS=# 300  while over budget a source may start one NEW code per N seconds
OTP_FAKE_SEND_DELAY_MS=          # 350  pause of a pretend send (staff/unknown numbers) so timing doesn't leak
# Staff/customer temporary-password message: set WHATSAPP_TEMP_PASSWORD_TEMPLATE_NAME
# (approved template, ONE variable {{1}} = the password); blank = free text in an open 24 h chat.
