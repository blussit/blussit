# App
APP_NAME="Doorstep Vehicle Care Platform"
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=doorstep_vehicle_care

# JWT
JWT_SECRET_KEY=change-this-super-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage (Cloudinary-ready abstraction - Phase 2 keys)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# WhatsApp messaging (OTPs, temp passwords, booking/subscription updates).
# Leave WHATSAPP_PROVIDER=log (or the two keys below blank) to run without
# a real WhatsApp account — messages are written to the whatsapp_outbox
# collection instead of sent, so everything still works end-to-end in dev.
# To send for real: set WHATSAPP_PROVIDER=meta_cloud and fill in a token +
# phone number ID from a WhatsApp Cloud API app (Meta for Developers).
WHATSAPP_PROVIDER=log
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
