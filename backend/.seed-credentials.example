# Copy to backend/.seed-credentials.local (git-ignored) to choose your own
# local-dev seed passwords. If that file is absent, `python -m app.seed` /
# `scripts/dev.sh seed` generate random ones and write the file (mode 600).
# Env vars of the same names take precedence. Staff accounts are only ever
# seeded on a LOCAL database, never on Atlas/production.
SEED_ADMIN_PASSWORD=<choose-a-strong-password>
SEED_MANAGER_PASSWORD=<choose-a-strong-password>
SEED_CAPTAIN_PASSWORD=<choose-a-strong-password>
