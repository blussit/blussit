venv

# Secrets: every .env EXCEPT the committed placeholder examples.
# frontend/ and backend/ each already carry their own .gitignore covering
# .env; this repeats it at the root so a new package added later is safe by
# default rather than by remembering.
.env
.env.*
!.env.example
!*/.env.example
# Local-dev templates (no real keys) — see SETUP_WINDOWS.md
!*/.env.development.example
backend/.env
backend/app/__pycache__
__pycache__
frontend/node_modules
blussit-prelaunch/frontend/node_modules
.claude
backend/uploads/
backend/private_uploads/

# Local dev runner state (pids, logs) — scripts/dev.sh
.dev/
*.log
*.pid

# Local test-database snapshot to share with teammates (see SETUP_WINDOWS.md) — not committed.
# These hold real phone numbers, emails and password hashes: never commit a
# database dump anywhere in the tree (P0-1, docs/SECURITY_REPO_CLEANUP.md).
devdata/
*.archive
*.archive.gz
*.bson
*.bson.gz

# Local dev seed passwords (generated by app.seed; never commit)
backend/.seed-credentials.local
.seed-credentials.local

# Google Cloud CLI (local install, never commit)
/google-cloud-sdk/
/google-cloud-cli-linux-x86_64.tar.gz
